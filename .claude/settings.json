{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "php \"${CLAUDE_PROJECT_DIR}/.claude/hooks/formatar.php\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(composer run *)",
      "Bash(composer lint)",
      "Bash(composer analyse)",
      "Bash(composer test)",
      "Bash(composer check)",
      "Bash(php artisan *)",
      "Bash(php vendor/bin/pint *)",
      "Bash(php vendor/bin/pest *)",
      "Bash(php vendor/bin/phpstan *)",
      "Bash(npm run *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(php artisan migrate:fresh --env=production *)",
      "Bash(php artisan db:wipe *)"
    ]
  }
}
