# =============================================================================
# B2BSAFE — variáveis de ambiente
# Copie para .env (o `composer setup` faz isso). NUNCA versione o .env.
# Valores abaixo servem para o ambiente LOCAL (Docker). Em homologação e produção
# os valores reais ficam só no .env do servidor.
# =============================================================================

APP_NAME=B2BSAFE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Interface em português; datas gravadas em UTC e exibidas em America/Sao_Paulo (RN-020)
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE_EXIBICAO=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logs em JSON, um arquivo por dia (RNF de logs: 90 dias em produção)
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Banco: MariaDB do docker-compose (mesmo banco da Hostinger)
# -----------------------------------------------------------------------------
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3314
DB_DATABASE=b2bsafe
DB_USERNAME=b2bsafe
DB_PASSWORD=b2bsafe-local
# Só para o container do MariaDB local
DB_ROOT_PASSWORD=raiz-local

# Sessão, cache e fila no banco: a hospedagem compartilhada não tem Redis (ADR-004)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# E-mail. Local: Mailpit (http://localhost:8026). Demonstração: SMTP do Gmail
# com senha de app. Produção: contato@b2bsafe.com.br.
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1026
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@b2bsafe.test"
MAIL_FROM_NAME="${APP_NAME}"

# Quem recebe o aviso de novo lead (RF-007)
EMAIL_LEADS=leads@b2bsafe.test

# E-mail público do rodapé (RF-001)
EMAIL_CONTATO=contato@b2bsafe.com.br

# -----------------------------------------------------------------------------
# Negócio (config/b2bsafe.php)
# -----------------------------------------------------------------------------
WHATSAPP_GERAL=5511984205023
WHATSAPP_MAQUININHA=5511924600991
VERSAO_POLITICA_PRIVACIDADE=1
VERSAO_AVISO_CHAT=1
VERSAO_COOKIES=1

# Google Analytics 4: ID de medição (G-XXXXXXXXXX). Vazio = GA4 desligado.
GA4_ID_MEDICAO=

# -----------------------------------------------------------------------------
# Assistente virtual (n8n). URL e segredo ficam SÓ no servidor (RF-014).
# Local: http://localhost:5679/webhook/<caminho>. Demonstração: URL do trycloudflare.
# -----------------------------------------------------------------------------
CHATBOT_N8N_URL=
CHATBOT_N8N_SEGREDO=
CHATBOT_TEMPO_LIMITE=10

# -----------------------------------------------------------------------------
# Docker local (docker-compose.yml). Portas próprias para não conflitar com
# outros projetos; tudo em 127.0.0.1.
# -----------------------------------------------------------------------------
PORTA_APP=8014
PORTA_BANCO=3314
PORTA_MAILPIT_WEB=8026
PORTA_MAILPIT_SMTP=1026
PORTA_N8N=5679
PORTA_QDRANT=6335

# Chave que cifra as credenciais guardadas no n8n. Gere uma vez e não troque:
#   php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_URL=http://localhost:5679/
QDRANT_API_KEY=

VITE_APP_NAME="${APP_NAME}"
