{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "gabrielcunhalima/b2bsafe-site",
    "type": "project",
    "description": "Site institucional da B2BSAFE Floripa, captação de leads, assistente virtual e painel.",
    "keywords": [
        "laravel",
        "filament",
        "b2bsafe"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.11",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "mallardduck/blade-lucide-icons": "^2.0",
        "relaticle/flowforge": "^4.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.14",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-browser": "^5.2",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "@composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi",
            "@php docker/gerar-chave-n8n.php",
            "docker compose up -d --wait mariadb mailpit",
            "@php artisan migrate --seed --force",
            "npm install",
            "npm run build",
            "npx lefthook install"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --test"
        ],
        "format": [
            "pint"
        ],
        "analyse": [
            "phpstan analyse --memory-limit=1G --no-progress"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "pest --testsuite=Unit,Feature"
        ],
        "test:e2e": [
            "@php artisan config:clear --ansi @no_additional_args",
            "pest --testsuite=Browser"
        ],
        "test:cobertura": [
            "@php artisan config:clear --ansi @no_additional_args",
            "pest --testsuite=Unit,Feature --coverage"
        ],
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "setup": "Prepara o ambiente local do zero (dependências, .env, Docker, banco, assets, hooks)",
        "dev": "Sobe servidor, Vite e fila para desenvolvimento",
        "lint": "Confere a formatação (Pint) sem alterar arquivos",
        "format": "Formata o código com o Pint",
        "analyse": "Análise estática (Larastan nível 6)",
        "test": "Testes unitários e de feature (Pest)",
        "test:e2e": "Testes no navegador (Pest Browser + Playwright); exige npm run build",
        "test:cobertura": "Testes com relatório de cobertura (exige Xdebug ou PCOV)",
        "check": "Roda lint, análise estática e testes (o mesmo que o CI)"
    }
}
